---
// Standard Server-Side Rendering (SSR) Pattern:
// 
// 1. Browser Request: The user visits /users-ssr.
// 2. Server Processing: The server receives the request and starts changing the page.
// 3. Blocking Data Fetch: The await getUsers() call pauses the rendering. The server waits for the external API.
// 4. HTML Generation: Once data arrives, the full HTML is generated on the server.
// 5. Response: The complete HTML (with data) is sent to the browser.
// 
// Result: The user sees a white screen (or browser spinner) while the data is fetching, 
// but receives the fully populated page consistently.

import MainLayout from '../layouts/MainLayout.astro';
import LikeButtonIsland from '../components/like-button/LikeButtonIsland.astro';
import UserInfo from '../components/UserInfo';
import RequestWaterfall from '../components/RequestWaterfall.astro';
import type { User } from '../types/user';
import { getUsers } from '../lib/users';

const users: User[] = await getUsers();


// let users: User[] = []; 
// try {
//   const res = await fetch('https://jsonplaceholder.typicode.com/users');
//   if (!res.ok) throw new Error('Failed to fetch users');
//   users = await res.json();
// } catch (err) {
//   console.error('Error fetching users:', err);
// }
---
<!-- 2. The Component Template -->

<MainLayout title="Users (SSR)">
  <h1>Users (SSR)</h1>
  <p>
    <strong>Data Fetched:</strong> During the request, on the server.<br/>
    <strong>Page Rendered:</strong> On every request, on the server.
  </p>

  <ul>
    {users.map(user => (
      <li style={{ marginBottom: '1rem' }}>
        <UserInfo id={user.id} name={user.name} email={user.email} />
        <LikeButtonIsland />
      </li>
    ))}
  </ul>

  <RequestWaterfall 
    steps={[
      { label: 'Browser Request', type: 'client', description: 'User navigates to /users-ssr' },
      { label: 'Server Processing', type: 'server', description: 'Astro receives the request' },
      { label: 'Data Fetch', type: 'api', description: 'Server fetches data from external API' },
      { label: 'HTML Generation', type: 'server', description: 'Components rendered to HTML string' },
      { label: 'Response', type: 'client', description: 'Full HTML sent to browser' },
      { label: 'Hydration', type: 'client', description: 'Interactive islands become active' }
    ]}
  />
</MainLayout>