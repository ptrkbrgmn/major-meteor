---
interface Step {
  label: string;
  type: 'client' | 'server' | 'api' | 'build';
  description?: string;
  duration?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<div class="waterfall-container">
  <h3>Request Waterfall</h3>
  <div class="waterfall">
    {steps.map((step, index) => (
      <div class={`step step-${step.type}`} style={`--delay: ${index * 0.1}s`}>
        <div class="step-marker">
          <span class="step-index">{index + 1}</span>
          <div class="step-line"></div>
        </div>
        <div class="step-content">
          <span class="step-label">{step.label}</span>
          {step.description && <span class="step-desc">{step.description}</span>}
          {step.duration && <span class="step-duration">{step.duration}</span>}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .waterfall-container {
    margin-top: 3rem;
    padding: 1.5rem;
    background: #f8f9fa;
    border-radius: 8px;
    border: 1px solid #e9ecef;
  }
  
  h3 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 1.2rem;
    color: #495057;
  }

  .waterfall {
    position: relative;
    padding-left: 1rem;
  }

  .step {
    display: flex;
    gap: 1rem;
    position: relative;
    padding-bottom: 1.5rem;
    opacity: 0;
    animation: fadeIn 0.5s ease forwards;
    animation-delay: var(--delay);
  }

  .step:last-child {
    padding-bottom: 0;
  }

  .step:last-child .step-line {
    display: none;
  }

  .step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 2rem;
  }

  .step-index {
    width: 24px;
    height: 24px;
    background: #6c757d;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: bold;
    z-index: 1;
  }

  .step-line {
    flex-grow: 1;
    width: 2px;
    background: #dee2e6;
    margin-top: 0.5rem;
    min-height: 2rem;
  }

  .step-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    padding-top: 0.1rem;
  }

  .step-label {
    font-weight: 600;
    color: #212529;
  }

  .step-desc {
    font-size: 0.9rem;
    color: #6c757d;
    margin-top: 0.2rem;
  }

  .step-duration {
    font-size: 0.8rem;
    color: #adb5bd;
    margin-top: 0.2rem;
    font-family: monospace;
  }

  .step-server .step-index { background-color: #0d6efd; }
  .step-client .step-index { background-color: #198754; }
  .step-api .step-index { background-color: #fd7e14; }
  .step-build .step-index { background-color: #6610f2; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
